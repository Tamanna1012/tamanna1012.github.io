---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="Page Not Found" description="This page doesn't exist.">
  <Section class="flex min-h-[60vh] flex-col items-center justify-center text-center">
    <p class="font-mono-label text-sm text-[var(--brand)]">404</p>
    <h1 class="mt-3 font-display text-3xl font-semibold text-[var(--ink)]">
      This page doesn't exist
    </h1>
    <p class="mt-3 max-w-md text-[var(--ink-muted)]">
      The link might be broken, or the page may have moved.
    </p>
    <div class="mt-8 flex gap-3">
      <Button href="/">Go Home</Button>
      <Button href="/projects" variant="secondary">View Projects</Button>
    </div>
  </Section>
</BaseLayout>
