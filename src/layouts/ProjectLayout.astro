---
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import DomainBadge from "../components/domain/DomainBadge.astro";
import ProjectMeta from "../components/project/ProjectMeta.astro";
import RelatedProjects from "../components/project/RelatedProjects.astro";
import type { ProjectEntry } from "../lib/getProjects";

interface Props {
  project: ProjectEntry;
  related: ProjectEntry[];
}
const { project, related } = Astro.props;
const { data } = project;
---

<BaseLayout title={data.title} description={data.summary} image={data.coverImage.src}>
  <article>
    <div class="mx-auto max-w-6xl px-6 pt-12">
      <div class="mb-4 flex flex-wrap gap-1.5">
        {data.domains.map((d) => <DomainBadge domain={d} />)}
      </div>
      <h1 class="font-display text-3xl font-semibold text-[var(--ink)] md:text-4xl">
        {data.title}
      </h1>
      <p class="mt-3 max-w-2xl text-lg text-[var(--ink-muted)]">{data.summary}</p>
    </div>

    <div class="mx-auto mt-8 max-w-6xl overflow-hidden rounded-[var(--radius)] px-6">
      <Image
        src={data.coverImage}
        alt={data.title}
        width={1200}
        height={630}
        class="w-full rounded-[var(--radius)] border border-[var(--line)] object-cover"
      />
    </div>

    <div class="mx-auto max-w-6xl px-6 py-12">
      <div class="grid gap-10 lg:grid-cols-[1fr_320px]">
        <div class="min-w-0">
          {data.metrics && data.metrics.length > 0 && (
            <div class="mb-8 grid grid-cols-2 gap-4 sm:grid-cols-3">
              {data.metrics.map((m) => (
                <div class="rounded-[var(--radius)] border border-[var(--line)] bg-[var(--surface-2)] p-4">
                  <p class="font-display text-xl font-semibold text-[var(--brand)]">{m.value}</p>
                  <p class="mt-1 font-mono-label text-xs text-[var(--ink-muted)]">{m.label}</p>
                </div>
              ))}
            </div>
          )}

          <ul class="mb-8 space-y-2">
            {data.highlights.map((h) => (
              <li class="flex gap-2 text-sm text-[var(--ink)]">
                <span class="text-[var(--brand)]">&#9642;</span>
                <span>{h}</span>
              </li>
            ))}
          </ul>

          <div class="prose-content">
            <slot />
          </div>
        </div>

        <aside class="lg:sticky lg:top-24 lg:h-fit">
          <ProjectMeta data={data} />
        </aside>
      </div>

      <RelatedProjects projects={related} />
    </div>
  </article>
</BaseLayout>

<style>
  .prose-content :global(h2) {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--ink);
  }
  .prose-content :global(p) {
    margin-bottom: 1rem;
    line-height: 1.7;
    color: var(--ink);
  }
  .prose-content :global(ul) {
    margin-bottom: 1rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .prose-content :global(code) {
    font-family: var(--font-mono);
    background: var(--surface-2);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.85em;
  }
  .prose-content :global(pre) {
    background: #16171a;
    color: #e4e1da;
    padding: 1rem;
    border-radius: var(--radius);
    overflow-x: auto;
    margin-bottom: 1rem;
  }
</style>
