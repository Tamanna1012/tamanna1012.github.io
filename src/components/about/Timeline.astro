---
import DomainBadge from "../domain/DomainBadge.astro";
import type { ExperienceEntry } from "../../lib/getExperience";

interface Props {
  entries: ExperienceEntry[];
}
const { entries } = Astro.props;

const dateFmt = (d: Date) => d.toLocaleDateString("en-US", { month: "short", year: "numeric" });
---

{
  entries.length === 0 ? (
    <div class="rounded-[var(--radius)] border border-dashed border-[var(--line)] bg-[var(--surface-2)] p-12 text-center">
      <p class="font-mono-label text-sm text-[var(--ink-muted)]">Experience will appear here as it's added.</p>
    </div>
  ) : (
    <ol class="space-y-8 border-l border-[var(--line)] pl-6">
      {entries.map((entry) => {
        const dateRange = entry.data.date.ended
          ? `${dateFmt(entry.data.date.started)} - ${dateFmt(entry.data.date.ended)}`
          : `${dateFmt(entry.data.date.started)} - Present`;
        return (
          <li class="relative">
            <span class="absolute -left-[calc(1.5rem+3px)] top-1.5 h-2.5 w-2.5 rounded-full bg-[var(--brand)]" />
            <p class="font-mono-label text-xs uppercase text-[var(--ink-muted)]">{dateRange}</p>
            <h3 class="mt-1 font-display text-lg font-semibold text-[var(--ink)]">{entry.data.role}</h3>
            <p class="text-sm text-[var(--ink-muted)]">
              {entry.data.organization}
              {entry.data.location ? ` · ${entry.data.location}` : ""}
            </p>
            <p class="mt-2 max-w-2xl text-sm text-[var(--ink-muted)]">{entry.data.summary}</p>
            {entry.data.domains && entry.data.domains.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-1.5">
                {entry.data.domains.map((d) => (
                  <DomainBadge domain={d} />
                ))}
              </div>
            )}
          </li>
        );
      })}
    </ol>
  )
}
