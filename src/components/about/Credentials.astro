---
import type { CertificationEntry } from "../../lib/getCertifications";

interface Props {
  entries: CertificationEntry[];
}
const { entries } = Astro.props;

const dateFmt = (d: Date) => d.toLocaleDateString("en-US", { month: "short", year: "numeric" });
---

{
  entries.length === 0 ? (
    <div class="rounded-[var(--radius)] border border-dashed border-[var(--line)] bg-[var(--surface-2)] p-12 text-center">
      <p class="font-mono-label text-sm text-[var(--ink-muted)]">Certifications will appear here as they're added.</p>
    </div>
  ) : (
    <ul class="grid gap-4 sm:grid-cols-2">
      {entries.map((entry) => {
        const Tag = entry.data.credentialUrl ? "a" : "div";
        return (
          <li>
            <Tag
              href={entry.data.credentialUrl}
              class:list={[
                "block rounded-[var(--radius)] border border-[var(--line)] bg-[var(--surface)] p-4",
                entry.data.credentialUrl && "transition-colors hover:border-[var(--brand)]",
              ]}
            >
              <p class="font-semibold text-[var(--ink)]">{entry.data.title}</p>
              <p class="text-sm text-[var(--ink-muted)]">{entry.data.issuer}</p>
              <p class="mt-1 font-mono-label text-xs uppercase text-[var(--ink-muted)]">
                {dateFmt(entry.data.date)}
              </p>
            </Tag>
          </li>
        );
      })}
    </ul>
  )
}
