---
import ProjectCard from "./ProjectCard.astro";
import type { ProjectEntry } from "../../lib/getProjects";

interface Props {
  projects: ProjectEntry[];
}
const { projects } = Astro.props;
---

{
  projects.length > 0 && (
    <div class="mt-16">
      <h2 class="mb-6 font-display text-xl font-semibold text-[var(--ink)]">Related work</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((p) => (
          <ProjectCard project={p} />
        ))}
      </div>
    </div>
  )
}
