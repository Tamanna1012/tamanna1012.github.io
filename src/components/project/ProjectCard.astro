---
import { Image } from "astro:assets";
import Card from "../ui/Card.astro";
import Badge from "../ui/Badge.astro";
import DomainBadge from "../domain/DomainBadge.astro";
import type { ProjectEntry } from "../../lib/getProjects";

interface Props {
  project: ProjectEntry;
}
const { project } = Astro.props;
const { data } = project;
---

<Card href={`/projects/${project.id}`} class="overflow-hidden">
  <div class="aspect-[16/9] w-full overflow-hidden bg-[var(--surface-2)]">
    <Image
      src={data.coverImage}
      alt={data.title}
      width={640}
      height={360}
      class="h-full w-full object-cover"
    />
  </div>
  <div class="p-5">
    <div class="mb-2 flex flex-wrap gap-1.5">
      {data.domains.map((d) => (
        <DomainBadge domain={d} linked={false} />
      ))}
    </div>
    <h3 class="font-display text-lg font-semibold text-[var(--ink)]">{data.title}</h3>
    <p class="mt-1.5 text-sm text-[var(--ink-muted)]">{data.summary}</p>
    <div class="mt-3 flex flex-wrap gap-1.5">
      {data.stack.slice(0, 5).map((tech) => (
        <Badge label={tech} variant="tech" />
      ))}
      {data.stack.length > 5 && (
        <Badge label={`+${data.stack.length - 5}`} variant="tech" />
      )}
    </div>
  </div>
</Card>
