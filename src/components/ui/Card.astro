---
interface Props {
  href?: string;
  class?: string;
}
const { href, class: className = "" } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag
  href={href}
  class:list={[
    "block rounded-[var(--radius)] border border-[var(--line)] bg-[var(--surface)] shadow-[var(--shadow)] transition-transform hover:-translate-y-0.5",
    className,
  ]}
>
  <slot />
</Tag>
