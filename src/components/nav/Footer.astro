---
import { SITE } from "../../data/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--line)] py-10">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-3 px-6 text-center">
    <p class="text-sm text-[var(--ink-muted)]">
      &copy; {year} {SITE.name}. Built to grow -- new work appears here automatically.
    </p>
    <div class="flex gap-4 text-sm">
      <a href={SITE.social.github} class="text-[var(--ink-muted)] hover:text-[var(--brand)]">GitHub</a>
      <a href={`mailto:${SITE.email}`} class="text-[var(--ink-muted)] hover:text-[var(--brand)]">Email</a>
      <a href={SITE.resumeUrl} class="text-[var(--ink-muted)] hover:text-[var(--brand)]">Resume</a>
    </div>
  </div>
</footer>
